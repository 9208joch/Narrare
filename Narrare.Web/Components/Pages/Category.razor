@page "/categories/{id:int}"

@using Narrare.Application.DTOs
@using Narrare.Web.Services

@inject CategoriesApiService CategoriesApiService

<PageTitle>Kategori – Narrare</PageTitle>

<div class="page-container">

    @if (category == null)
    {
        <p>Laddar kategori...</p>
    }
    else
    {
        <h1>@category.Name</h1>

        <p>
            @category.Description
        </p>

        <hr />

        <h2>Inlägg</h2>

        <p>
            Inläggen i denna kategori kommer att visas här.
        </p>
    }

</div>

@code {

    [Parameter]
    public int Id { get; set; }

    private CategoryDto? category;

    protected override async Task OnInitializedAsync()
    {
        category = await CategoriesApiService.GetByIdAsync(Id);
    }
}