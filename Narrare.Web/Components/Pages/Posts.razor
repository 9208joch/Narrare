@page "/posts"

@using Narrare.Application.DTOs
@using Narrare.Domain.Entities
@using Narrare.Web.Services
@using Microsoft.AspNetCore.Components.Forms

@inject PostsApiService PostsApiService
@inject CommentsApiService CommentsApiService
@inject CurrentUserService CurrentUserService
@inject NavigationManager NavigationManager
@inject PostImagesApiService PostImagesApiService
@inject CommentImagesApiService CommentImagesApiService
@inject ApiService ApiService

<h1 class="mb-4">Narrare</h1>
@if (CurrentUserService.IsLoggedIn)
{
    <div class="alert alert-success">
        Inloggad som: @CurrentUserService.CurrentUser!.Username
        (ID: @CurrentUserService.CurrentUser.Id)
    </div>
}
else
{
    <div class="alert alert-warning">
        Ingen användare är inloggad.
    </div>
}

@if (CurrentUserService.IsLoggedIn)
{
    <!-- Skapa nytt inlägg -->
    <div class="card mb-4">
        <div class="card-body">

            <h3 class="card-title">Skapa nytt inlägg</h3>

            <div class="mb-3">
                <label class="form-label">Titel</label>

                <input class="form-control"
                       @bind="newPost.Title" />
            </div>
            
            <div class="mb-3">
                <label class="form-label">Innehåll</label>

                <textarea class="form-control"
                          rows="4"
                          @bind="newPost.Content"></textarea>
            </div>

            <!-- Bifoga bild -->
            <div class="mb-3">
                <label class="form-label">Bifoga bild</label>

                <InputFile OnChange="HandlePostImageSelected"
                           accept="image/jpeg,image/png,image/webp"
                           class="form-control" />

                @if (selectedPostImage != null)
                {
                    <p class="mt-2 mb-0">
                        Vald bild: @selectedPostImage.Name
                    </p>
                }

                <small class="text-muted">
                    JPG, PNG eller WebP. Max 20 MB.
                </small>
            </div>

            <button class="btn btn-primary"
                    @onclick="CreatePost">
                Skapa inlägg
            </button>

        </div>
    </div>
}



