@page "/posts"

@using Narrare.Application.DTOs
@using Narrare.Domain.Entities
@using Narrare.Web.Services

@inject PostsApiService PostsApiService
@inject CommentsApiService CommentsApiService
@inject CurrentUserService CurrentUserService

<h1 class="mb-4">Narrare</h1>
@if (CurrentUserService.IsLoggedIn)
{
    <div class="alert alert-success">
        Inloggad som: @CurrentUserService.CurrentUser!.Username
        (ID: @CurrentUserService.CurrentUser.Id)
    </div>
}
else
{
    <div class="alert alert-warning">
        Ingen användare är inloggad.
    </div>
}
<!-- Skapa nytt inlägg -->
<div class="card mb-4">
    <div class="card-body">
        
        <h3 class="card-title">Skapa nytt inlägg</h3>

        <div class="mb-3">
            <label class="form-label">Titel</label>

            <input class="form-control"
                   @bind="newPost.Title" />
        </div>

        <div class="mb-3">
            <label class="form-label">Innehåll</label>

            <textarea class="form-control"
                      rows="4"
                      @bind="newPost.Content"></textarea>
        </div>

        <button class="btn btn-primary"
                @onclick="CreatePost">
            Skapa inlägg
        </button>

    </div>
</div>


<!-- Inlägg -->
@if (posts == null)
{
    <p>Laddar...</p>
}
else if (posts.Count == 0)
{
    <p>Inga inlägg hittades.</p>
}
else
{
    @foreach (var post in posts)
    {
        <div class="card mb-4">
            <div class="card-body">

                @if (editingPosts.ContainsKey(post.Id)
    && editingPosts[post.Id])
                {
                    <input class="form-control mb-2"
                           @bind="editedPostTitles[post.Id]" />

                    <textarea class="form-control mb-2"
                              rows="4"
                              @bind="editedPostContents[post.Id]"></textarea>

                    <button class="btn btn-success btn-sm me-2"
                            @onclick="() => SavePost(post)">
                        Spara
                    </button>

                    <button class="btn btn-secondary btn-sm"
                            @onclick="() => CancelPostEdit(post.Id)">
                        Avbryt
                    </button>
                }
                else
                {
                    <h3 class="card-title">
                        @post.Title
                    </h3>

                    <p class="text-muted">
                        @post.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                    </p>

                    <p class="card-text">
                        @post.Content
                    </p>

                    <button class="btn btn-outline-secondary btn-sm me-2"
                            @onclick="() => EditPost(post)">
                        Redigera
                    </button>

                    <button class="btn btn-outline-danger btn-sm"
                            @onclick="() => DeletePost(post)">
                        Radera
                    </button>
                }

                @if (comments.ContainsKey(post.Id))
                {
                    <hr />

                    <h5>Kommentarer</h5>

                    @if (comments[post.Id].Count == 0)
                    {
                        <p class="text-muted">
                            Inga kommentarer ännu.
                        </p>
                    }
                    else
                    {
                        @foreach (var comment in comments[post.Id])
                        {
                            <div class="border rounded p-2 mb-2">

                                @if (editingComments.ContainsKey(comment.Id)
                                    && editingComments[comment.Id])
                                {
                                    <textarea class="form-control mb-2"
                                              @bind="editedCommentContent[comment.Id]"></textarea>

                                    <button class="btn btn-success btn-sm me-2"
                                            @onclick="() => SaveComment(comment)">
                                        Spara
                                    </button>
                                    
                                    <button class="btn btn-secondary btn-sm"
                                            @onclick="() => CancelEdit(comment.Id)">
                                        Avbryt
                                    </button>
                                }
                                else
                                {
                                    <p class="mb-1">
                                        @comment.Content
                                    </p>

                                    <small class="text-muted">
                                        @comment.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                                    </small>

                                    <br />

                                    <button class="btn btn-outline-secondary btn-sm mt-2 me-2"
                                            @onclick="() => EditComment(comment)">
                                        Redigera
                                    </button>

                                    <button class="btn btn-outline-danger btn-sm mt-2"
                                            @onclick="() => DeleteComment(comment)">
                                        Radera
                                    </button>
                                }

                            </div>
                        }
                    }

                    <div class="mt-3">
                        <textarea class="form-control"
                                  rows="2"
                                  placeholder="Skriv en kommentar..."
                                  @bind="newCommentContent[post.Id]"></textarea>

                        <button class="btn btn-secondary mt-2"
                                @onclick="() => CreateComment(post.Id)">
                            Kommentera
                        </button>
                    </div>

                }

            </div>
        </div>
    }
}


@code {
    private Dictionary<int, string> newCommentContent = new();

    private List<PostDto>? posts;

    private Dictionary<int, List<CommentDto>> comments = new();

    private Dictionary<int, bool> editingComments = new();

    private Dictionary<int, string> editedCommentContent = new();

    private Dictionary<int, bool> editingPosts = new();

    private Dictionary<int, string> editedPostTitles = new();

    private Dictionary<int, string> editedPostContents = new();

    private Post newPost = new()
    {
        CategoryId = 2
    };

    
    protected override async Task OnInitializedAsync()
    {
        posts = await PostsApiService.GetAllAsync();

        if (posts == null)
        {
            return;
        }

        foreach (var post in posts)
        {
            var postComments =
                await CommentsApiService.GetByPostAsync(post.Id);

            comments[post.Id] =
                postComments ?? new List<CommentDto>();

            newCommentContent[post.Id] = string.Empty;
        }
    }


    private async Task CreatePost()
{
    if (!CurrentUserService.IsLoggedIn)
    {
        return;
    }
        
    newPost.UserId = CurrentUserService.CurrentUser!.Id;

    var createdPost =
        await PostsApiService.CreateAsync(newPost);

    if (createdPost == null)
    {
        return;
    }

    posts ??= new List<PostDto>();

    posts.Add(createdPost);

    comments[createdPost.Id] =
        new List<CommentDto>();
        newCommentContent[createdPost.Id] = string.Empty;

    newPost = new Post
    {
        CategoryId = 2
    };
}
    
    private async Task CreateComment(int postId)
    {
        if (!CurrentUserService.IsLoggedIn)
        {
            return;
        }

        if (!newCommentContent.TryGetValue(postId, out var content)
            || string.IsNullOrWhiteSpace(content))
        {
            return;
        }

        var comment = new Comment
        {
            Content = content,
            UserId = CurrentUserService.CurrentUser!.Id,
            PostId = postId
        };

        var createdComment =
            await CommentsApiService.CreateAsync(comment);

        if (createdComment == null)
        {
            return;
        }

        if (!comments.ContainsKey(postId))
        {
            comments[postId] = new List<CommentDto>();
        }

        comments[postId].Add(createdComment);

        newCommentContent[postId] = string.Empty;
    }
    private void EditComment(CommentDto comment)
    {
        editingComments[comment.Id] = true;
        editedCommentContent[comment.Id] = comment.Content;
    }
    private void CancelEdit(int commentId)
    {
        editingComments[commentId] = false;
    }
    private async Task SaveComment(CommentDto comment)
    {
        if (!editedCommentContent.TryGetValue(comment.Id, out var content)
            || string.IsNullOrWhiteSpace(content))
        {
            return;
        }
        
        var updatedComment = new Comment
        {
            Content = content,
            UserId = comment.UserId,
            PostId = comment.PostId
        };

        var result = await CommentsApiService.UpdateAsync(
            comment.Id,
            updatedComment);

        if (result == null)
        {
            return;
        }
        
        comment.Content = result.Content;
        comment.UpdatedAt = result.UpdatedAt;

        editingComments[comment.Id] = false;
    }
    private async Task DeleteComment(CommentDto comment)
    {
        var success = await CommentsApiService.DeleteAsync(comment.Id);

        if (!success)
        {
            return;
        }

        if (comments.TryGetValue(comment.PostId, out var postComments))
        {
            postComments.Remove(comment);
        }
    }
    private void EditPost(PostDto post)
    {
        editingPosts[post.Id] = true;
        editedPostTitles[post.Id] = post.Title;
        editedPostContents[post.Id] = post.Content;
    }

    private void CancelPostEdit(int postId)
    {
        editingPosts[postId] = false;
    }

    private async Task SavePost(PostDto post)
    {
        if (!editedPostTitles.TryGetValue(post.Id, out var title)
            || string.IsNullOrWhiteSpace(title))
        {
            return;
        }

        if (!editedPostContents.TryGetValue(post.Id, out var content)
            || string.IsNullOrWhiteSpace(content))
        {
            return;
        }
        
        var updatedPost = new Post
        {
            Title = title,
            Content = content,
            UserId = post.UserId,
            CategoryId = post.CategoryId
        };

        var result = await PostsApiService.UpdateAsync(
            post.Id,
            updatedPost);

        if (result == null)
        {
            return;
        }

        post.Title = result.Title;
        post.Content = result.Content;
        post.UpdatedAt = result.UpdatedAt;

        editingPosts[post.Id] = false;
    }
    private async Task DeletePost(PostDto post)
    {
        var success = await PostsApiService.DeleteAsync(post.Id);

        if (!success)
        {
            return;
        }

        posts?.Remove(post);
        comments.Remove(post.Id);
        newCommentContent.Remove(post.Id);
    }

}