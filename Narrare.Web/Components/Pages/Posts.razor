@code {
    private Dictionary<int, string> newCommentContent = new();

    private List<PostDto>? posts;
    // Vilket inläggs meny som är öppen.
    private int? openReportMenuPostId;

    // Vilken kommentar som är öppen i menyn.
    private int? openReportMenuCommentId;

    private Dictionary<int, List<PostImageDto>> postImages = new();

    private Dictionary<int, List<CommentDto>> comments = new();

    private Dictionary<int, bool> editingComments = new();

    private Dictionary<int, string> editedCommentContent = new();

    private Dictionary<int, bool> editingPosts = new();

    private Dictionary<int, string> editedPostTitles = new();

    private Dictionary<int, string> editedPostContents = new();

    private Dictionary<int, List<CommentImageDto>> commentImages = new();

    private IBrowserFile? selectedPostImage;

    private void HandlePostImageSelected(InputFileChangeEventArgs e)
    {
        selectedPostImage = e.File;
    }

    private Post newPost = new()
    {
        CategoryId = 2
    };

    
    protected override async Task OnInitializedAsync()
    {
        posts = await PostsApiService.GetAllAsync();
        
        if (posts == null)
        {
            return;
        }

        // Hämta bilder för varje inlägg.
        foreach (var post in posts)
        {
            var images =
                await PostImagesApiService.GetByPostAsync(post.Id);

            postImages[post.Id] =
                images ?? new List<PostImageDto>();
        }
        
        // Hämta kommentarer för varje inlägg.
        foreach (var post in posts)
        {
            var postComments =
    await CommentsApiService.GetByPostAsync(post.Id);

            comments[post.Id] =
                postComments ?? new List<CommentDto>();

            // Hämta bilder för varje kommentar.
            foreach (var comment in comments[post.Id])
            {
                var images =
                    await CommentImagesApiService.GetByCommentAsync(comment.Id);

                commentImages[comment.Id] =
                    images ?? new List<CommentImageDto>();
            }

            newCommentContent[post.Id] = string.Empty;
        }

        // Hämta kommentarbilder för varje kommentar.
        foreach (var post in posts)
        {
        }
    }

    
private async Task CreatePost()
{
    if (!CurrentUserService.IsLoggedIn)
    {
        return;
    }

    newPost.UserId = CurrentUserService.CurrentUser!.Id;

    var createdPost =
        await PostsApiService.CreateAsync(newPost);

    if (createdPost == null)
    {
        return;
    }

    // Ladda upp och koppla bilden om användaren har valt en.
    if (selectedPostImage != null)
    {
        var uploadedImage = await ApiService.UploadAsync<UploadedImageDto>(
            "api/Images/upload",
            selectedPostImage);

        if (uploadedImage != null)
        {
            await ApiService.PostAsync(
                $"api/Images/posts/{createdPost.Id}/images/{uploadedImage.Id}",
                new { });
        }
    }

    // Hämta alla inlägg igen.
    posts = await PostsApiService.GetAllAsync();

    if (posts != null)
    {
        posts = posts
            .OrderByDescending(post => post.CreatedAt)
            .ToList();
    }

    if (posts == null)
    {
        return;
    }

    // Hämta bilderna igen så att den nya bilden visas.
    foreach (var post in posts)
    {
        var images =
            await PostImagesApiService.GetByPostAsync(post.Id);

        postImages[post.Id] =
            images ?? new List<PostImageDto>();
    }

    // Förbered kommentarsfält för det nya inlägget.
    comments[createdPost.Id] = new List<CommentDto>();
    newCommentContent[createdPost.Id] = string.Empty;

    // Återställ formuläret.
    selectedPostImage = null;

    newPost = new Post
    {
        CategoryId = 2
    };
}
    
    private async Task CreateComment(int postId)
    {
        if (!CurrentUserService.IsLoggedIn)
        {
            return;
        }

        if (!newCommentContent.TryGetValue(postId, out var content)
            || string.IsNullOrWhiteSpace(content))
        {
            return;
        }
        
        var comment = new Comment
        {
            Content = content,
            UserId = CurrentUserService.CurrentUser!.Id,
            PostId = postId
        };

        var createdComment =
            await CommentsApiService.CreateAsync(comment);

        if (createdComment == null)
        {
            return;
        }

        if (!comments.ContainsKey(postId))
        {
            comments[postId] = new List<CommentDto>();
        }

        comments[postId].Add(createdComment);

        newCommentContent[postId] = string.Empty;
    }
    private void EditComment(CommentDto comment)
    {
        if (!CurrentUserService.IsLoggedIn)
        {
            return;
        }
        
        editingComments[comment.Id] = true;
        editedCommentContent[comment.Id] = comment.Content;
    }
    private void CancelEdit(int commentId)
    {
        editingComments[commentId] = false;
    }
    private async Task SaveComment(CommentDto comment)
    {
        if (!CurrentUserService.IsLoggedIn)
        {
            return;
        }
        if (!editedCommentContent.TryGetValue(comment.Id, out var content)
            || string.IsNullOrWhiteSpace(content))
        {
            return;
        }
        
        var updatedComment = new Comment
        {
            Content = content,
            UserId = comment.UserId,
            PostId = comment.PostId
        };

        var result = await CommentsApiService.UpdateAsync(
            comment.Id,
            updatedComment);

        if (result == null)
        {
            return;
        }
        
        comment.Content = result.Content;
        comment.UpdatedAt = result.UpdatedAt;

        editingComments[comment.Id] = false;
    }
    private async Task DeleteComment(CommentDto comment)
    {
        if (!CurrentUserService.IsLoggedIn)
        {
            return;
        }

        var success = await CommentsApiService.DeleteAsync(comment.Id);

        if (!success)
        {
            return;
        }
        
        // Behåll kommentaren i listan så att
        // modereringsmeddelandet kan visas.
        comment.IsDeleted = true;
        comment.DeletedByUserId = CurrentUserService.CurrentUser!.Id;
        comment.DeletedAt = DateTime.UtcNow;

        // Stäng eventuell redigering.
        editingComments[comment.Id] = false;
    }
    private void EditPost(PostDto post)
    {
        if (!CurrentUserService.IsLoggedIn)
        {
            return;
        }

        editingPosts[post.Id] = true;
        editedPostTitles[post.Id] = post.Title;
        editedPostContents[post.Id] = post.Content;
    }
    
    private void CancelPostEdit(int postId)
    {
        editingPosts[postId] = false;
    }

    private async Task SavePost(PostDto post)
    {
        if (!CurrentUserService.IsLoggedIn)
        {
            return;
        }
        if (!editedPostTitles.TryGetValue(post.Id, out var title)
            || string.IsNullOrWhiteSpace(title))
        {
            return;
        }
        
        if (!editedPostContents.TryGetValue(post.Id, out var content)
            || string.IsNullOrWhiteSpace(content))
        {
            return;
        }
        
        var updatedPost = new Post
        {
            Title = title,
            Content = content,
            UserId = post.UserId,
            CategoryId = post.CategoryId
        };

        var result = await PostsApiService.UpdateAsync(
            post.Id,
            updatedPost);

        if (result == null)
        {
            return;
        }

        post.Title = result.Title;
        post.Content = result.Content;
        post.UpdatedAt = result.UpdatedAt;
        
        editingPosts[post.Id] = false;
    }
    private async Task DeletePost(PostDto post)
    {
        if (!CurrentUserService.IsLoggedIn)
        {
            return;
        }

        var success = await PostsApiService.DeleteAsync(post.Id);

        if (!success)
        {
            return;
        }
         

        // Visa att inlägget har modererats istället för att
        // ta bort det från listan.
        post.IsDeleted = true;
        post.DeletedByUserId = CurrentUserService.CurrentUser!.Id;
        post.DeletedAt = DateTime.UtcNow;

        // Stäng eventuell redigering.
        editingPosts[post.Id] = false;

        // Kommentarerna ska inte längre visas.
        comments.Remove(post.Id);
        newCommentContent.Remove(post.Id);
    }
    private void TogglePostReportMenu(int postId)
    {
        if (openReportMenuPostId == postId)
        {
            openReportMenuPostId = null;
        }
        else
        {
            openReportMenuPostId = postId;
            openReportMenuCommentId = null;
        }
    }
    
    private void StartPostReport(int postId)
    {
        openReportMenuPostId = null;

        // Popup-rutan kopplar vi in i nästa steg.
    }
    
    private void ToggleCommentReportMenu(int commentId)
    {
        if (openReportMenuCommentId == commentId)
        {
            openReportMenuCommentId = null;
        }
        else
        {
            openReportMenuCommentId = commentId;
            openReportMenuPostId = null;
        }
    }

    private void StartCommentReport(int commentId)
    {
        openReportMenuCommentId = null;

        // Popup-rutan kopplar vi in i nästa steg.
    }

    
}




    
