@page "/register"

@using Narrare.Application.DTOs
@using Narrare.Web.Services
@using Microsoft.AspNetCore.Components.Forms

@inject UsersApiService UsersApiService
@inject ApiService ApiService
@inject NavigationManager NavigationManager

<h1 class="mb-4">Registrera konto</h1>

<div class="card">
    <div class="card-body">

        <div class="mb-3">
            <label class="form-label">Användarnamn</label>

            <input class="form-control"
                   @bind="user.Username" />
        </div>

        <div class="mb-3">
            <label class="form-label">Lösenord</label>

            <input class="form-control"
                   type="password"
                   @bind="user.Password" />
        </div>

        <div class="mb-3">
            <label class="form-label">Ålder</label>

            <input class="form-control"
                   type="number"
                   @bind="user.Age" />
        </div>

        <div class="mb-3">
            <label class="form-label">Plats</label>

            <input class="form-control"
                   @bind="user.Location" />
        </div>

        <div class="mb-3">
            <label class="form-label">Yrke</label>

            <input class="form-control"
                   @bind="user.Occupation" />
        </div>

        <div class="mb-3">
            <label class="form-label">Profilbild</label>
            <InputFile OnChange="OnProfileImageSelected"
                       accept="image/*"
                       class="form-control" />
        </div>

        <button class="btn btn-primary"
                @onclick="RegisterUser">
            Registrera
        </button>

        @if (!string.IsNullOrWhiteSpace(message))
        {
            <div class="alert alert-success mt-3">
                @message
            </div>
        }

    </div>
</div>

@code {
    private RegisterUserDto user = new();

    private string? message;

    private async Task RegisterUser()
    {
        message = null;

        try
        {
            // Ladda upp profilbilden om en bild har valts.
            if (selectedProfileImage != null)
            {
                var uploadedImage =
                    await ApiService.UploadAsync<UploadedImageDto>(
                        "api/Images/upload",
                        selectedProfileImage);

                if (uploadedImage == null)
                {
                    message = "Profilbilden kunde inte laddas upp.";
                    return;
                }

                // Spara bildens API-adress på användaren.
                user.ProfileImageUrl =
                    $"https://localhost:7206/api/Images/{uploadedImage.Id}";
            }

            // Registrera användaren med profilbildens adress.
            var result = await UsersApiService.RegisterAsync(user);

            if (result == null)
            {
                message = "Registreringen misslyckades.";
                return;
            }

            message = $"Användaren {result.Username} skapades!";

            user = new RegisterUserDto();
            selectedProfileImage = null;
        }
        catch (HttpRequestException ex)
        {
            message = $"Ett fel uppstod vid uppladdningen: {ex.Message}";
        }
    }
    private IBrowserFile? selectedProfileImage;
    
    private void OnProfileImageSelected(
        InputFileChangeEventArgs e)
    {
        selectedProfileImage = e.File;
    }
}