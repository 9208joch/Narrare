@page "/pages/{Slug}"

@using Narrare.Web.Services
@using PageEntity = Narrare.Domain.Entities.Page

@inject PagesApiService PagesApiService

<div class="page-container">

    @if (currentPage == null)
    {
        <p>Laddar sida...</p>
    }
    else
    {
        <h1>@currentPage.Title</h1>

        <p>
            @currentPage.Content
        </p>

        <p class="text-muted">
            Besökare: @currentPage.VisitCount
        </p>
    }

</div>

@code
{
    [Parameter]
    public string Slug { get; set; } = string.Empty;

    private PageEntity? currentPage;

    protected override async Task OnParametersSetAsync()
    {
        // Hämta sidan
        currentPage = await PagesApiService.GetBySlugAsync(Slug);

        if (currentPage == null)
        {
            return;
        }

        // Öka besöksräknaren
        var success =
            await PagesApiService.IncrementVisitCountAsync(currentPage.Id);

        if (success)
        {
            // Uppdatera även objektet som visas på sidan
            currentPage.VisitCount++;
        }
    }
}