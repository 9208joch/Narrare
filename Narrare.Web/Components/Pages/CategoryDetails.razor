@page "/categories/{id:int}"
@* CategoryDetails.razor *@
@using Narrare.Application.DTOs
@using Narrare.Domain.Entities
@using Narrare.Web.Services
@using Microsoft.AspNetCore.Components.Forms

@inject CategoriesApiService CategoriesApiService
@inject PostsApiService PostsApiService
@inject CurrentUserService CurrentUserService
@inject CommentsApiService CommentsApiService
@inject ApiService ApiService
@inject PostImagesApiService PostImagesApiService
@inject ContentReportsApiService ContentReportsApiService




<PageTitle>Kategori – Narrare</PageTitle>

<div class="page-container">

    @if (category == null)
    {
        <p>Laddar kategori...</p>
    }
    else
    {
        <h1>@category.Name</h1>

        <p>
            @category.Description
        </p>

        <hr />

        @if (CurrentUserService.IsLoggedIn)
        {
            <div class="card mb-4">
                <div class="card-body">

                    <h3>Skapa nytt inlägg</h3>

                    <div class="mb-3">
                        <label class="form-label">
                            Titel
                        </label>
                        
                        <input class="form-control"
                               @bind="newPost.Title" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">
                            Innehåll
                        </label>

                        <textarea class="form-control"
                                  rows="5"
                                  @bind="newPost.Content">
                        </textarea>
                    </div>
                    <!-- Bifoga bild -->
                    <div class="mb-3">
                        <label class="form-label">
                            Bifoga bild
                        </label>

                        <InputFile OnChange="HandlePostImageSelected"
                                   accept="image/jpeg,image/png,image/webp"
                                   class="form-control" />

                        @if (selectedPostImage != null)
                        {
                            <p class="mt-2 mb-0">
                                Vald bild: @selectedPostImage.Name
                            </p>
                        }

                        <small class="text-muted">
                            JPG, PNG eller WebP. Max 20 MB.
                        </small>
                    </div>

                    <button class="btn btn-primary"
                            @onclick="CreatePost">
                        Skapa inlägg
                    </button>

                </div>
            </div>
        }
        
        
        
        @if (posts == null)
        {
            <p>Laddar inlägg...</p>
        }
        else if (posts.Count == 0)
        {
            <p>Det finns inga inlägg i denna kategori ännu.</p>
        }
        else
        {
            <div class="post-list">

                @foreach (var post in posts)
                {
                    <div class="post-card">

                        @if (CurrentUserService.IsLoggedIn &&
    editingPosts.ContainsKey(post.Id) &&
    editingPosts[post.Id])
                        {
                            
                            <input class="form-control mb-2"
                                   @bind="editedPostTitles[post.Id]" />

                            <textarea class="form-control mb-2"
                                      rows="4"
                                      @bind="editedPostContents[post.Id]"></textarea>

                            <button class="btn btn-success btn-sm me-2"
                                    @onclick="() => SavePost(post)">
                                Spara
                            </button>

                            <button class="btn btn-secondary btn-sm"
                                    @onclick="() => CancelPostEdit(post.Id)">
                                Avbryt
                            </button>
                        }
                        else
                        {

                            
                            <div class="d-flex justify-content-between align-items-center gap-2 mb-2">
                                <a href="@($"/users/{post.UserId}")"
                                   class="d-flex align-items-center gap-2 text-decoration-none text-reset">

                                    <img src="@(string.IsNullOrWhiteSpace(post.ProfileImageUrl)
                                                    ? "/images/BackUpProfile.png"
                                                    : post.ProfileImageUrl)"
                                         alt="Profilbild"
                                         class="rounded-circle"
                                         style="width: 75px; height: 75px; object-fit: cover;" />

                                    <strong>@post.Username</strong>
                                </a>

                                @if (CurrentUserService.IsLoggedIn)
                                {
                                    <div class="dropdown position-relative">
                                        <button type="button"
                                                class="btn btn-link text-dark text-decoration-none p-1"
                                                title="Fler alternativ"
                                                aria-label="Fler alternativ för inlägget"
                                                @onclick="() => TogglePostReportMenu(post.Id)">
                                            <span style="font-size: 1.6rem; line-height: 1;">⋮</span>
                                        </button>
                                        
                                        @if (openReportMenuPostId == post.Id)
                                        {
                                            <div class="dropdown-menu show"
                                                 style="position: absolute; top: 100%; right: 0; z-index: 1000;">
                                                <button type="button"
                                                        class="dropdown-item"
                                                        @onclick="() => StartPostReport(post.Id)">
                                                    Anmäl
                                                </button>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>


                            
                            
                            @if (post.IsDeleted)
                            {
                                <h3>Inlägg borttaget</h3>

                                <p class="fst-italic text-muted">
                                    Detta inlägg har tagits bort eftersom det strider mot Narrares regler.
                                </p>
                            }
                            else
                            {
                                <h3>@post.Title</h3>
                                <p>@post.Content</p>

                                @if (postImages.TryGetValue(post.Id, out var images)
                                     && images.Count > 0)
                                {
                                    <div class="d-flex flex-wrap gap-3 mt-3 mb-3">
                                        @foreach (var image in images.OrderBy(image => image.SortOrder))
                                        {
                                            <img src="@($"https://localhost:7206/api/Images/{image.ImageId}")"
                                                 alt="Bild till inlägget"
                                                 class="img-fluid rounded"
                                                 style="max-width: 250px; max-height: 250px; object-fit: contain;" />
                                        }
                                    </div>
                                }
                            }

                            <small>
                                Skapad: @post.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                            </small>

                            
                            @if (CurrentUserService.IsLoggedIn &&
                             (post.UserId == CurrentUserService.CurrentUser!.Id ||
                             CurrentUserService.CurrentUser.Role == Narrare.Domain.Enums.UserRole.Admin))
                            {
                                <div class="mt-2">
                                    <button class="btn btn-outline-secondary btn-sm me-2"
                                            @onclick="() => EditPost(post)">
                                        Redigera
                                    </button>

                                    <button class="btn btn-outline-danger btn-sm"
                                            @onclick="() => DeletePost(post)">
                                        Radera
                                    </button>
                                </div>
                            }
                        }

                        

                       <h5>Kommentarer</h5>

@if (!comments.TryGetValue(post.Id, out var postComments))
{
    <p>Laddar kommentarer...</p>
}
else if (postComments.Count == 0)
{
    <p class="text-muted">
        Inga kommentarer ännu.
    </p>
}
else
                        {
                            
    @foreach (var comment in postComments)
    {
                                <div class="border border-4 rounded p-2 mb-2">
                                    @if (CurrentUserService.IsLoggedIn)
                                    {
                                        <div class="dropdown text-end">
                                            <button type="button"
                                                    class="btn btn-link text-dark text-decoration-none p-1"
                                                    title="Fler alternativ"
                                                    aria-label="Fler alternativ för kommentaren"
                                                    @onclick="() => ToggleCommentReportMenu(comment.Id)">
                                                <span style="font-size: 1.6rem; line-height: 1;">⋮</span>
                                            </button>

                                            @if (openReportMenuCommentId == comment.Id)
                                            {
                                                <div class="dropdown-menu show position-absolute end-0"
                                                     style="z-index: 1050;">
                                                    <button type="button"
                                                            class="dropdown-item"
                                                            @onclick="() => OpenCommentReportModal(comment.Id)">
                                                        <i class="bi bi-flag me-2"></i>
                                                        Anmäl kommentar
                                                    </button>
                                                </div>
                                            }
                                        </div>
                                    }

            @if (CurrentUserService.IsLoggedIn &&
                 editingComments.ContainsKey(comment.Id) &&
                 editingComments[comment.Id])
            {
                <textarea class="form-control mb-2"
                          rows="3"
                          @bind="editedCommentContents[comment.Id]">
                </textarea>

                <button class="btn btn-success btn-sm me-2"
                        @onclick="() => SaveComment(comment)">
                    Spara
                </button>

                <button class="btn btn-secondary btn-sm"
                        @onclick="() => CancelCommentEdit(comment.Id)">
                    Avbryt
                </button>
            }
            else
            {

                                        <div class="d-flex align-items-center gap-2 mb-2">
                                            <a href="@($"/users/{comment.UserId}")"
                                               class="d-flex align-items-center gap-2 text-decoration-none text-reset">

                                                <img src="@(string.IsNullOrWhiteSpace(comment.ProfileImageUrl)
                                                                ? "/images/BackUpProfile.png"
                                                                : comment.ProfileImageUrl)"
                                                     alt="Profilbild"
                                                     class="rounded-circle"
                                                     style="width: 50px; height: 50px; object-fit: cover;" />

                                                <strong>@comment.Username</strong>
                                            </a>
                                        </div>

                                        
                                        @if (comment.IsDeleted)
                                        {
                                            <p class="mb-1 fst-italic text-muted">
                                                Denna kommentar har tagits bort eftersom den strider mot Narrares regler.
                                            </p>
                                        }
                                        else
                                        {
                                            <p class="mb-1">@comment.Content</p>
                                        }
                                        
                     <small class="text-muted">
                   Skapad:
                     @comment.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                       </small>


                @if (CurrentUserService.IsLoggedIn &&
                     (comment.UserId == CurrentUserService.CurrentUser!.Id ||
                      CurrentUserService.CurrentUser.Role == Narrare.Domain.Enums.UserRole.Admin))
                {
                    <div class="mt-2">
                        <button class="btn btn-outline-secondary btn-sm me-2"
                                @onclick="() => EditComment(comment)">
                            Redigera
                        </button>

                        <button class="btn btn-outline-danger btn-sm"
                                @onclick="() => DeleteComment(comment)">
                            Radera
                        </button>
                    </div>
                }
            }

        </div>
    }
} 
<hr />
                        
                        
                        @if (CurrentUserService.IsLoggedIn)
                        {
                            <div class="mt-3">

                                <textarea class="form-control"
                                          rows="2"
                                          placeholder="Skriv en kommentar..."
                                          @bind="newCommentContent[post.Id]"></textarea>

                                <button class="btn btn-secondary mt-2"
                                        @onclick="() => CreateComment(post.Id)">
                                    Kommentera
                                </button>

                            </div>
                        }

                    </div>
                }

            </div>
        }
    }

</div>

@if (showReportModal)
{
    <div class="modal d-block"
         tabindex="-1"
         role="dialog"
         style="background-color: rgba(0, 0, 0, 0.5);"
         aria-modal="true">

        <div class="modal-dialog modal-dialog-centered"
             role="document">

            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">Anmäl innehåll</h5>

                    <button type="button"
                            class="btn-close"
                            aria-label="Stäng"
                            @onclick="CloseReportModal">
                    </button>
                </div>

                <div class="modal-body">
                    <p>
                        Berätta varför du anmäler det här innehållet.
                    </p>

                    <label class="form-label"
                           for="reportReason">
                        Motivering
                    </label>

                    <textarea id="reportReason"
                              class="form-control"
                              rows="4"
                              maxlength="1000"
                              placeholder="Beskriv anledningen till anmälan..."
                              @bind="reportReason">
                    </textarea>

                    <small class="text-muted">
                        Max 1000 tecken.
                    </small>

                    @if (!string.IsNullOrWhiteSpace(reportMessage))
                    {
                        <div class="alert @(reportSucceeded ? "alert-success" : "alert-danger") mt-3">
                            @reportMessage
                        </div>
                    }
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-secondary"
                            @onclick="CloseReportModal">
                        Avbryt
                    </button>

                    <button type="button"
                            class="btn btn-primary"
                            disabled="@string.IsNullOrWhiteSpace(reportReason)"
                            @onclick="SubmitReportAsync">
                        Skicka anmälan
                    </button>
                </div>

            </div>
        </div>
    </div>
}

@code {
    
    [Parameter]
    public int Id { get; set; }

    private CategoryDto? category;

    private List<PostDto>? posts;
    // Vilket inläggs meny som är öppen.
    private int? openReportMenuPostId;

    private int? openReportMenuCommentId;
    
    private Dictionary<int, List<PostImageDto>> postImages = new();

    private Post newPost = new();

    private Dictionary<int, List<CommentDto>> comments = new();

    private Dictionary<int, string> newCommentContent = new();

    private Dictionary<int, bool> editingPosts = new();

    private Dictionary<int, string> editedPostTitles = new();

    private Dictionary<int, string> editedPostContents = new();

    private Dictionary<int, bool> editingComments = new();

    private Dictionary<int, string> editedCommentContents = new();

    private IBrowserFile? selectedPostImage;

    private void HandlePostImageSelected(InputFileChangeEventArgs e)
    {
        selectedPostImage = e.File;
    }
    
    protected override async Task OnInitializedAsync()
    {
        category = await CategoriesApiService.GetByIdAsync(Id);

        if (category != null)
        {
            posts = await PostsApiService.GetByCategoryAsync(Id);
            foreach (var post in posts)
            {
                var images =
                    await PostImagesApiService.GetByPostAsync(post.Id);

                postImages[post.Id] =
                    images ?? new List<PostImageDto>();
            }
            foreach (var post in posts)
            {
                if (!newCommentContent.ContainsKey(post.Id))
                {
                    newCommentContent[post.Id] = "";
                }

                if (!editedPostTitles.ContainsKey(post.Id))
                {
                    editedPostTitles[post.Id] = post.Title;
                }

                if (!editedPostContents.ContainsKey(post.Id))
                {
                    editedPostContents[post.Id] = post.Content;
                }
            }

            if (posts != null)
            {
                if (posts != null)
                {
                    foreach (var post in posts)
                    {
                        var postComments =
                            await CommentsApiService.GetByPostAsync(post.Id);

                        comments[post.Id] =
                            postComments ?? new List<CommentDto>();
                    }
                }
}
        }
    }
    
    private async Task CreatePost()
{
    if (!CurrentUserService.IsLoggedIn)
    {
        return;
    }

    if (string.IsNullOrWhiteSpace(newPost.Title))
    {
        return;
    }

    if (string.IsNullOrWhiteSpace(newPost.Content))
    {
        return;
    }

    // Ange användaren och kategorin.
    newPost.UserId = CurrentUserService.CurrentUser!.Id;
    newPost.CategoryId = Id;

    // Skapa inlägget först.
    var createdPost =
        await PostsApiService.CreateAsync(newPost);

    if (createdPost == null)
    {
        return;
    }

    // Ladda upp bilden om användaren har valt en.
        // if (selectedPostImage != null) att fixa för testning
    // {
            if (selectedPostImage != null)
            {
                Console.WriteLine(
                    $"TEST: Bild vald: {selectedPostImage.Name}");

                Console.WriteLine("TEST: Försöker ladda upp bilden.");
        var uploadedImage = await ApiService.UploadAsync<UploadedImageDto>(
            "api/Images/upload",
            selectedPostImage);
            
        // Koppla den uppladdade bilden till inlägget.
            // if (uploadedImage != null) att fixa för testning
        // {
        //     await ApiService.PostAsync(
        //         $"api/Images/posts/{createdPost.Id}/images/{uploadedImage.Id}",
        //         new { });
        // }
        if (uploadedImage != null)
{
    var linked = await ApiService.PostAsync(
        $"api/Images/posts/{createdPost.Id}/images/{uploadedImage.Id}",
        new { });

    if (!linked)
    {
        throw new HttpRequestException(
            $"Bilden laddades upp, men kunde inte kopplas till inlägget. " +
            $"PostId: {createdPost.Id}, ImageId: {uploadedImage.Id}");
    }
}
else
{
    throw new HttpRequestException(
        "API:t returnerade inget bildobjekt efter uppladdningen.");
}
    }
        

        // Lägg till det nya inlägget på sidan.
        posts ??= new List<PostDto>();
        posts.Insert(0, createdPost);

        // Hämta bilderna för det nya inlägget direkt.
        var images = await PostImagesApiService.GetByPostAsync(createdPost.Id);

        postImages[createdPost.Id] =
            images ?? new List<PostImageDto>();

    // Förbered kommentarsfunktionerna.
    newCommentContent[createdPost.Id] = "";
    comments[createdPost.Id] = new List<CommentDto>();
    editingPosts[createdPost.Id] = false;
    editedPostTitles[createdPost.Id] = createdPost.Title;
    editedPostContents[createdPost.Id] = createdPost.Content;

    // Återställ formuläret.
    selectedPostImage = null;

    newPost = new Post();
}
    
    private async Task CreateComment(int postId)
    {
        if (!CurrentUserService.IsLoggedIn)
        {
            return;
        }
        
        if (!newCommentContent.TryGetValue(postId, out var content)
            || string.IsNullOrWhiteSpace(content))
        {
            return;
        }

        var comment = new Comment
        {
            Content = content,
            UserId = CurrentUserService.CurrentUser!.Id,
            PostId = postId
        };

        var createdComment =
            await CommentsApiService.CreateAsync(comment);

        if (createdComment == null)
        {
            return;
        }

        if (!comments.ContainsKey(postId))
        {
            comments[postId] = new List<CommentDto>();
        }

        comments[postId].Add(createdComment);

        newCommentContent[postId] = string.Empty;
    }
    private void EditComment(CommentDto comment)
    {
        if (!CurrentUserService.IsLoggedIn)
        {
            return;
        }

        editingComments[comment.Id] = true;

        editedCommentContents[comment.Id] = comment.Content;
    }

    private void CancelCommentEdit(int commentId)
    {
        editingComments[commentId] = false;
    }

    private async Task SaveComment(CommentDto comment)
    {
        if (!CurrentUserService.IsLoggedIn)
        {
            return;
        }

        if (!editedCommentContents.ContainsKey(comment.Id))
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(editedCommentContents[comment.Id]))
        {
            return;
        }

        var updatedComment = new Comment
        {
            Id = comment.Id,
            Content = editedCommentContents[comment.Id],
            UserId = comment.UserId,
            PostId = comment.PostId
        };

        var result = await CommentsApiService.UpdateAsync(
            comment.Id,
            updatedComment);

        if (result == null)
        {
            return;
        }

        comment.Content = result.Content;
        comment.UpdatedAt = result.UpdatedAt;

        editingComments[comment.Id] = false;
    }

    private async Task DeleteComment(CommentDto comment)
    {
        if (!CurrentUserService.IsLoggedIn)
        {
            return;
        }

        if (comment.UserId != CurrentUserService.CurrentUser!.Id &&
            CurrentUserService.CurrentUser.Role != Narrare.Domain.Enums.UserRole.Admin)
        {
            return;
        }

        var success = await CommentsApiService.DeleteAsync(comment.Id);

        if (!success)
        {
            return;
        }

        if (comments.TryGetValue(comment.PostId, out var postComments))
        {
            postComments.Remove(comment);
        }
    }
    private void EditPost(PostDto post)
    {
        if (!CurrentUserService.IsLoggedIn)
        {
            return;
        }

        editingPosts[post.Id] = true;

        editedPostTitles[post.Id] = post.Title;
        editedPostContents[post.Id] = post.Content;
    }
    private void CancelPostEdit(int postId)
    {
        editingPosts[postId] = false;
    }
    private async Task SavePost(PostDto post)
    {
        if (!CurrentUserService.IsLoggedIn)
        {
            return;
        }

        if (!editedPostTitles.ContainsKey(post.Id) ||
            !editedPostContents.ContainsKey(post.Id))
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(editedPostTitles[post.Id]))
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(editedPostContents[post.Id]))
        {
            return;
        }

        var updatedPost = new Post
        {
            Id = post.Id,
            Title = editedPostTitles[post.Id],
            Content = editedPostContents[post.Id],
            UserId = post.UserId,
            CategoryId = post.CategoryId
        };

        var result = await PostsApiService.UpdateAsync(
            post.Id,
            updatedPost);

        if (result == null)
        {
            return;
        }
        
        post.Title = result.Title;
        post.Content = result.Content;
        post.UpdatedAt = result.UpdatedAt;

        editingPosts[post.Id] = false;
    }
    private async Task DeletePost(PostDto post)
    {
        if (!CurrentUserService.IsLoggedIn)
        {
            return;
        }
        
        
        if (post.UserId != CurrentUserService.CurrentUser!.Id &&
            CurrentUserService.CurrentUser.Role != Narrare.Domain.Enums.UserRole.Admin)
        {
            return;
        }
        
        var success = await PostsApiService.DeleteAsync(post.Id);

        if (!success)
        {
            return;
        }
        
        posts?.Remove(post);
    }
    private void TogglePostReportMenu(int postId)
    {
        if (openReportMenuPostId == postId)
        {
            openReportMenuPostId = null;
        }
        else
        {
            openReportMenuPostId = postId;
        }
    }
    private void ToggleCommentReportMenu(int commentId)
    {
        openReportMenuCommentId =
            openReportMenuCommentId == commentId ? null : commentId;
    }

    private void StartPostReport(int postId)
    {
        openReportMenuPostId = null;

        reportPostId = postId;
        reportCommentId = null;

        reportReason = string.Empty;
        reportMessage = null;
        reportSucceeded = false;

        showReportModal = true;
    }
    // Vilket innehåll som ska anmälas.
    private int? reportPostId;
    private int? reportCommentId;
    
    // Popup-rutans synlighet.
    private bool showReportModal;

    // Användarens motivering.
    private string reportReason = string.Empty;

    // Meddelande efter att anmälan skickats.
    private string? reportMessage;
    private bool reportSucceeded;

    private void CloseReportModal()
    {
        showReportModal = false;

        reportPostId = null;
        reportCommentId = null;
        
        reportReason = string.Empty;
        reportMessage = null;
    }
    
    private async Task SubmitReportAsync()
    {
        // Kontrollera att det finns en motivering.
        if (string.IsNullOrWhiteSpace(reportReason))
        {
            reportMessage = "Du måste ange en motivering.";
            reportSucceeded = false;
            return;
        }

        // Skapa en begäran till API:t.
        var request = new CreateContentReportDto
        {
            PostId = reportPostId,
            CommentId = reportCommentId,
            Reason = reportReason.Trim()
        };

        try
        {
            bool success = await ContentReportsApiService.CreateAsync(request);

            if (success)
            {
                reportSucceeded = true;
                reportMessage = "Din anmälan har skickats.";
                reportReason = string.Empty;
            }
            else
            {
                reportSucceeded = false;
                reportMessage = "Anmälan kunde inte skickas. Försök igen.";
            }
        }
        catch (Exception)
        {
            reportSucceeded = false;
            reportMessage = "Ett fel uppstod när anmälan skulle skickas.";
        }
    }
    private void OpenCommentReportModal(int commentId)
    {
        reportCommentId = commentId;
        reportPostId = null;
        reportReason = string.Empty;
        reportMessage = string.Empty;
        reportSucceeded = false;
        showReportModal = true;
        openReportMenuCommentId = null;
    }
    
}
